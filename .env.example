# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=notes-files

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key

# Google Drive Configuration
GDRIVE_FOLDER_ID=your-goodnotes-backup-folder-id
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials.json

# Email Notification Configuration (Resend or SMTP)
EMAIL_PROVIDER=resend # 'resend' or 'smtp'
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_RECIPIENT_EMAIL=your_email@example.com
SENDER_EMAIL=notes@yourdomain.com

# SMTP Settings (Used if EMAIL_PROVIDER=smtp)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=notes@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# Pipeline Settings
CHECK_INTERVAL_SECONDS=300
